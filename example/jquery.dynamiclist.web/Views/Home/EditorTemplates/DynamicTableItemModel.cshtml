@model DynamicListItemModel
<tr class="item">
    <td>
        <input asp-for="Id" type="text" data-val-number="The field Id must be a number." class="form-control k-input" />
        <span asp-validation-for="Id"></span>
    </td>
    <td>
        <input asp-for="Name" type="text" class="form-control k-input" />
        <span asp-validation-for="Name"></span>
    </td>
</tr>
